<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <benchmark name="Rotation_Benchmark" outpath="jube_bench_run">

    <!-- Paramètres des flags de compilation -->
    <parameterset name="comp_mem_allocator_flag">
      <parameter name="mem_allocator_flag" type="string">USE_POSIX_MEMALIGN,USE_MALLOC</parameter>
    </parameterset>

    <!-- 1. Paramètres du benchmark (Dimensions de la matrice) -->
    <parameterset name="matrix_params">
      <parameter name="nrows" type="int">1024, 2048</parameter>
      <parameter name="ncols" type="int">1024</parameter>
      <parameter name="ridx1" type="int">0</parameter>
      <parameter name="ridx2" type="int">1</parameter>

      <!-- Paramètre dérivé : vaut 1 si la combinaison est valide, 0 sinon -->
      <!-- ridx2 doit être strictement inférieur à nrows -->
      <parameter name="valid" mode="python" type="int">1 if ${ridx2} &lt; ${nrows} else 0</parameter>
    </parameterset>

    <!-- Variables d'environnement pour la compilation -->
    <parameterset name="env_params">
      <parameter name="FORGE_ROOT">${jube_benchmark_home}/../..</parameter>
      <parameter name="RESOLVE_CPATH_FORGE" type="string">-I${FORGE_ROOT} -I${FORGE_ROOT}/fwht_utils -I${FORGE_ROOT}/fwht</parameter>
      <parameter name="RESOLVE_LD" type="string">-L${GUIX_ENVIRONMENT}/lib -lopenblas -lfftw3 -lfftw3_omp -lpthread -lm -lfwht</parameter>
      <!-- $GUIX_ENVIRONMENT est transmis automatiquement par ton shell actif -->
      <!-- <parameter name="GUIX_ENV" type="string">${GUIX_ENVIRONMENT}</parameter> -->
      <!-- <parameter name="RESOLVE_CPATH" type="string">-I${FORGE_ROOT} -I${FORGE_ROOT}/fwht_utils -I${FORGE_ROOT}/fwht -I${GUIX_ENV}/include</parameter> -->
    </parameterset>

    <!-- Fichiers à copier dans le dossier d'exécution (Sandbox JUBE) -->
    <fileset name="source_files">
      <copy>${FORGE_ROOT}/fwht_utils/hada.c</copy>
      <copy>${FORGE_ROOT}/fwht/base_fwht.c</copy>
      <copy>${FORGE_ROOT}/fwht/bench/fwht_bench_rotatedata_mat.c</copy>
    </fileset>

    <parameterset name="run_bench_cmd">
      <parameter name="command" type="string">./bench_exe --confidence=10.0 --output=results_${mem_allocator_flag}.csv</parameter>
    </parameterset>

    <!-- 2. Compilation -->
    <step name="compile" active="${valid}">
      <use>comp_mem_allocator_flag</use>
      <use>matrix_params</use>
      <use>env_params</use>
      <use>source_files</use>
      
      <!-- Compilation avec GCC -->
      <!-- On modifie le fichier C à la volée avant de compiler -->
      <do>sed -i 's/JUBE_NROWS/${nrows}/g' fwht_bench_rotatedata_mat.c</do>
      <do>sed -i 's/JUBE_NCOLS/${ncols}/g' fwht_bench_rotatedata_mat.c</do>
      <do>sed -i 's/JUBE_RIDX1/${ridx1}/g' fwht_bench_rotatedata_mat.c</do>
      <do>sed -i 's/JUBE_RIDX2/${ridx2}/g' fwht_bench_rotatedata_mat.c</do>
      <do>
        <!-- gcc -O3 -march=native -Wall -fopenmp -fopt-info-vec-all=vec.report -o bench_exe hada.c base_fwht.c fwht_bench_rotatedata_mat.c -L${GUIX_ENV}/lib -lopenblas -lfftw3 -lpthread -lm ${RESOLVE_CPATH} -->
        gcc -O3 -march=native -Wall -fopenmp -fopt-info-vec-all=vec.report -D${mem_allocator_flag} -o bench_exe hada.c base_fwht.c fwht_bench_rotatedata_mat.c ${RESOLVE_LD} ${RESOLVE_CPATH_FORGE} -I${GUIX_ENVIRONMENT}/include
        <!-- gcc -O2 -Wall -o bench_exe hada.c base_fwht.c fwht_bench_rotatedata_mat.c -L${GUIX_ENV}/lib -lopenblas -lpthread -lm -I${GUIX_ENV}/include ${RESOLVE_CPATH} -->
      </do>
    </step>

    <!-- 3. Exécution -->
    <step name="execute" depend="compile" active="${valid}">
      <use>matrix_params</use>
      <use>run_bench_cmd</use>
      <!-- Exécute le binaire et génère le fichier CSV de ubench -->
      <do>cp compile/bench_exe .</do>
      <do>$command</do>
    </step>

    <!-- 4. Collect : Collecte et concatène tous les fichiers results_${mem_allocator_flag}.csv -->
    <step name="collect" depend="execute">
      <use>comp_mem_allocator_flag</use>
      <!-- La première fois, on crée le header une seule fois dans le fichier de sortie -->
      <do><![CDATA[
        OUT="${jube_benchmark_home}/../output/rotatedata_mat_${mem_allocator_flag}_benchmark.csv"
        if [ ! -f "$OUT" ]; then
          head -n 1 execute/results_${mem_allocator_flag}.csv > "$OUT"
        fi
        tail -n +2 execute/results_${mem_allocator_flag}.csv >> "$OUT"
      ]]></do>
    </step>

<!--     <step name="plot" depend="collect">
      <use>comp_mem_allocator_flag</use>
      <use>matrix_params</use>
      <do>Rscript ${FORGE_ROOT}/fwht/rscripts/gen_bench.R ${FORGE_ROOT}/fwht/output/rotatedata_mat_${mem_allocator_flag}_benchmark.csv</do>
    </step> -->

  </benchmark>
</jube>