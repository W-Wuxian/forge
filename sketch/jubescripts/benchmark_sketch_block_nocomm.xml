<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <benchmark name="SKETCH_block_nocomm_Benchmark" outpath="jube_bench_sketch_block_nocomm_run">
    <!-- Paramètres des flags de compilation -->
    <parameterset name="comp_mem_allocator_flag">
      <parameter name="mem_allocator_flag" type="string">USE_POSIX_MEMALIGN,USE_MALLOC</parameter>
    </parameterset>
    <!-- 1. Paramètres du benchmark (Dimensions de la matrice) -->
    <parameterset name="matrix_params">
      <parameter name="nrows" type="int">1000</parameter>
      <parameter name="ncols" type="int">2</parameter>
      <parameter name="sketch_dim" type="int">5</parameter>
      <parameter name="sketch_alg" type="string">SRHT_CFWHT, SRHT_FFTW, SRHT_HADI_FWHT, SRHT_HADI_FWHT_OPENMP, GAUSS</parameter>
      <parameter name="sketch_type" type="string">SKETCH_2D</parameter>
    </parameterset>

    <!-- Variables d'environnement pour la compilation -->
    <parameterset name="env_params">
      <parameter name="FORGE_ROOT">${jube_benchmark_home}/../..</parameter>
      <parameter name="RESOLVE_CPATH_FORGE" type="string">-I${FORGE_ROOT} -I${FORGE_ROOT}/fwht_utils -I${FORGE_ROOT}/fwht -I$FORGE_ROOT/sketch</parameter>
      <parameter name="RESOLVE_LD" type="string">-L${GUIX_ENVIRONMENT}/lib -lopenblas -lfftw3 -lfftw3_omp -lpthread -lm -lfwht</parameter>
    </parameterset>

    <!-- Fichiers à copier dans le dossier d'exécution (Sandbox JUBE) -->
    <fileset name="source_files">
      <copy>${FORGE_ROOT}/sketch/sketch.c</copy>
      <copy>${FORGE_ROOT}/fwht_utils/hada.c</copy>
      <copy>${FORGE_ROOT}/fwht/base_fwht.c</copy>
      <copy>${FORGE_ROOT}/sketch/bench/sketch_bench_block_srht_nocomm.c</copy>
    </fileset>

    <parameterset name="run_bench_cmd">
      <parameter name="command" type="string">./bench_sketch_block_nocomm_exe --confidence=10.0 --output=results_sketch_block_nocomm_${mem_allocator_flag}.csv</parameter>
    </parameterset>

    <!-- 2. Compilation -->
    <step name="compile">
      <use>comp_mem_allocator_flag</use>
      <use>matrix_params</use>
      <use>env_params</use>
      <use>source_files</use>
      
      <!-- Compilation avec GCC -->
      <!-- On modifie le fichier C à la volée avant de compiler -->
      <do>sed -i 's/JUBE_NROWS/${nrows}/g' sketch_bench_block_srht_nocomm.c</do>
      <do>sed -i 's/JUBE_NCOLS/${ncols}/g' sketch_bench_block_srht_nocomm.c</do>
      <do>sed -i 's/JUBE_SKETCH_DIM/${sketch_dim}/g' sketch_bench_block_srht_nocomm.c</do>
      <do>sed -i 's/JUBE_SKETCH_ALG/${sketch_alg}/g' sketch_bench_block_srht_nocomm.c</do>
      <do>sed -i 's/JUBE_SKETCH_TYPE/${sketch_type}/g' sketch_bench_block_srht_nocomm.c</do>
      <do>
        <!-- gcc -O3 -march=native -Wall -fopenmp -fopt-info-vec-all=vec.report -DNDEBUG -DNOASSERTINT -DNOPRINTMAT -DFFTW_WITH_OMP -D${mem_allocator_flag} -o bench_sketch_block_nocomm_exe hada.c base_fwht.c sketch.c sketch_bench_block_srht_nocomm.c ${RESOLVE_LD} ${RESOLVE_CPATH} -->
        gcc -O0 -g3 -pg -march=native -Wall -fopenmp -fopt-info-vec-all=vec.report -DNDEBUG -DNOASSERTINT -DNOPRINTMAT -DFFTW_WITH_OMP -D${mem_allocator_flag} -o bench_sketch_block_nocomm_exe hada.c base_fwht.c sketch.c sketch_bench_block_srht_nocomm.c ${RESOLVE_LD} ${RESOLVE_CPATH_FORGE} -I${GUIX_ENVIRONMENT}/include
      </do>
    </step>

    <!-- 3. Exécution -->
    <step name="execute" depend="compile">
      <use>matrix_params</use>
      <use>run_bench_cmd</use>
      <!-- Exécute le binaire et génère le fichier CSV de ubench -->
      <do>cp compile/bench_sketch_block_nocomm_exe .</do>
      <do>$command</do>
    </step>

    <!-- 4. Collect : Collecte et concatène tous les fichiers results_fwht.csv -->
    <step name="collect" depend="execute">
      <use>comp_mem_allocator_flag</use>
      <!-- La première fois, on crée le header une seule fois dans le fichier de sortie -->
      <do><![CDATA[
        OUT="${jube_benchmark_home}/../output/sketch_block_nocomm_${mem_allocator_flag}_benchmark.csv"
        if [ ! -f "$OUT" ]; then
          head -n 1 execute/results_sketch_block_nocomm_${mem_allocator_flag}.csv | grep -v "Skipped" > "$OUT"
        fi
        tail -n +2 execute/results_sketch_block_nocomm_${mem_allocator_flag}.csv | grep -v "Skipped" >> "$OUT"
      ]]></do>
    </step>

  </benchmark>
</jube>